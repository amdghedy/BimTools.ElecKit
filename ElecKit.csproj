<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ElecKit</AssemblyName>
    <RootNamespace>ElecKit</RootNamespace>
    <!-- Revit 2020 runs on .NET Framework 4.7 -->
    <TargetFramework>net47</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <LangVersion>10.0</LangVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2020\</RevitInstallDir>
    <HasLocalRevit Condition="Exists('$(RevitInstallDir)RevitAPI.dll')">true</HasLocalRevit>
    <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\2020\</RevitAddinsDir>
  </PropertyGroup>

  <!-- Keep standalone test sources out of the Revit add-in compilation. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- Local build: use the DLLs from your Revit 2020 install -->
  <ItemGroup Condition="'$(HasLocalRevit)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- CI / machines without Revit: use the Revit API NuGet packages -->
  <ItemGroup Condition="'$(HasLocalRevit)' != 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2020.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2020.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Deploy only when the Revit 2020 API is installed. Copy exact outputs and verify expected files. -->
  <Target Name="DeployToRevit" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(HasLocalRevit)' == 'true' and Exists('$(TargetPath)')">
    <MakeDir Directories="$(RevitAddinsDir)ElecKit" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(RevitAddinsDir)ElecKit\ElecKit.dll" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\ElecKit.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Error Condition="!Exists('$(RevitAddinsDir)ElecKit.addin')" Text="ElecKit deployment failed: manifest was not copied to $(RevitAddinsDir)." />
    <Error Condition="!Exists('$(RevitAddinsDir)ElecKit\ElecKit.dll')" Text="ElecKit deployment failed: DLL was not copied to $(RevitAddinsDir)ElecKit." />
    <Message Importance="high" Text="ElecKit deployed to $(RevitAddinsDir); close Revit before rebuilding/replacing a loaded assembly." />
  </Target>

</Project>
