<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ElecKit</AssemblyName>
    <RootNamespace>ElecKit</RootNamespace>
    <!-- Defaults preserve the original Revit 2020 build. Override with -p:RevitVersion=2021..2027. -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2020</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2020'">net47</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2021' or '$(RevitVersion)' == '2022' or '$(RevitVersion)' == '2023' or '$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <LangVersion>10.0</LangVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>
    <HasLocalRevit Condition="Exists('$(RevitInstallDir)RevitAPI.dll')">true</HasLocalRevit>
    <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    <!-- Build directly into the selected version folder beside its manifest. -->
    <OutputPath>$(MSBuildProjectDirectory)\RevitVersions\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitApiPackageVersion>$(RevitVersion).*</RevitApiPackageVersion>
  </PropertyGroup>

  <!-- Prefer the exact installed Revit API when building on a workstation with that version installed. -->
  <ItemGroup Condition="'$(HasLocalRevit)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- CI builds resolve the API matching RevitVersion from NuGet. -->
  <ItemGroup Condition="'$(HasLocalRevit)' != 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Opt-in local deployment only; Release/CI builds never install files on the runner. -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and '$(DeployToRevit)' == 'true'">
    <ItemGroup>
      <_AddinFiles Include="$(OutDir)**\*.dll;$(OutDir)**\*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsDir)" />
    <Copy SourceFiles="@(_AddinFiles)" DestinationFolder="$(RevitAddinsDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\RevitVersions\$(RevitVersion)\ElecKit.addin" DestinationFolder="$(RevitAddinsDir)" />
  </Target>

</Project>
