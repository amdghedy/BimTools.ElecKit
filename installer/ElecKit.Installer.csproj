<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One setup .exe for every Revit version. The build workflow puts all per-version builds into
    installer\payload.zip first; this project embeds that zip, so the .exe needs nothing else.
    Runs without administrator rights: it installs into the current user's Revit add-ins folders.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ElecKit-Setup</AssemblyName>
    <RootNamespace>ElecKit.Installer</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>ElecKit</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
